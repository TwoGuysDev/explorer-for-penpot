{
  "name": "explorer-for-penpot",
  "displayName": "Explorer for Penpot",
  "description": "%extension.description%",
  "version": "0.6.0",
  "publisher": "TwoGuysDev",
  "author": "TwoGuysDev",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E1F23",
    "theme": "dark"
  },
  "homepage": "https://github.com/TwoGuysDev/explorer-for-penpot#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/TwoGuysDev/explorer-for-penpot.git"
  },
  "bugs": {
    "url": "https://github.com/TwoGuysDev/explorer-for-penpot/issues"
  },
  "keywords": [
    "penpot",
    "design",
    "ui",
    "preview",
    "design handoff",
    "mcp",
    "ai"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "penpotExplorer",
          "title": "%view.container%",
          "icon": "media/penpot.svg"
        }
      ]
    },
    "views": {
      "penpotExplorer": [
        {
          "id": "penpotExplorer.tree",
          "name": "%view.tree%"
        },
        {
          "id": "penpotExplorer.localFiles",
          "name": "%view.localFiles%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "penpotExplorer.tree",
        "contents": "%view.welcome%",
        "when": "!penpotExplorer.hasToken"
      }
    ],
    "commands": [
      {
        "command": "penpotExplorer.connect",
        "title": "%command.connect%",
        "category": "Penpot",
        "icon": "$(plug)"
      },
      {
        "command": "penpotExplorer.disconnect",
        "title": "%command.disconnect%",
        "category": "Penpot"
      },
      {
        "command": "penpotExplorer.refresh",
        "title": "%command.refresh%",
        "category": "Penpot",
        "icon": "$(refresh)"
      },
      {
        "command": "penpotExplorer.openInBrowser",
        "title": "%command.openInBrowser%",
        "category": "Penpot",
        "icon": "$(link-external)"
      },
      {
        "command": "penpotExplorer.preview",
        "title": "%command.preview%",
        "category": "Penpot",
        "icon": "$(eye)"
      },
      {
        "command": "penpotExplorer.refreshLocal",
        "title": "%command.refresh%",
        "category": "Penpot",
        "icon": "$(refresh)"
      },
      {
        "command": "penpotExplorer.openLocal",
        "title": "%command.openLocal%",
        "category": "Penpot",
        "icon": "$(eye)"
      },
      {
        "command": "penpotExplorer.mcp.start",
        "title": "%command.mcpStart%",
        "category": "Penpot"
      },
      {
        "command": "penpotExplorer.mcp.stop",
        "title": "%command.mcpStop%",
        "category": "Penpot"
      },
      {
        "command": "penpotExplorer.mcp.copySetup",
        "title": "%command.mcpCopySetup%",
        "category": "Penpot"
      },
      {
        "command": "penpotExplorer.mcp.menu",
        "title": "%command.mcpMenu%",
        "category": "Penpot"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "penpotExplorer.refresh",
          "when": "view == penpotExplorer.tree && penpotExplorer.hasToken",
          "group": "navigation"
        },
        {
          "command": "penpotExplorer.connect",
          "when": "view == penpotExplorer.tree",
          "group": "navigation"
        },
        {
          "command": "penpotExplorer.disconnect",
          "when": "view == penpotExplorer.tree && penpotExplorer.hasToken"
        },
        {
          "command": "penpotExplorer.refreshLocal",
          "when": "view == penpotExplorer.localFiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "penpotExplorer.preview",
          "when": "view == penpotExplorer.tree && viewItem =~ /^(frame|page)$/",
          "group": "inline"
        },
        {
          "command": "penpotExplorer.openInBrowser",
          "when": "view == penpotExplorer.tree && viewItem =~ /^(file|page|frame)$/",
          "group": "inline"
        },
        {
          "command": "penpotExplorer.openLocal",
          "when": "view == penpotExplorer.localFiles && viewItem =~ /^(localFile|localDesign|localPage)$/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "penpotExplorer.preview",
          "when": "false"
        },
        {
          "command": "penpotExplorer.openInBrowser",
          "when": "false"
        },
        {
          "command": "penpotExplorer.openLocal",
          "when": "false"
        },
        {
          "command": "penpotExplorer.refreshLocal",
          "when": "false"
        },
        {
          "command": "penpotExplorer.mcp.menu",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "penpotExplorer.openLocal",
          "when": "resourceExtname == .penpot",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Explorer for Penpot",
      "properties": {
        "penpotExplorer.serverUrl": {
          "type": "string",
          "default": "https://design.penpot.app",
          "markdownDescription": "%config.serverUrl%"
        },
        "penpotExplorer.preview.loadWebFonts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.loadWebFonts%"
        },
        "penpotExplorer.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.mcpEnabled%"
        },
        "penpotExplorer.mcp.port": {
          "type": "number",
          "default": 4410,
          "minimum": 1024,
          "maximum": 65535,
          "markdownDescription": "%config.mcpPort%"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "penpotExplorer.penpotFile",
        "displayName": "%editor.penpotFile%",
        "selector": [
          {
            "filenamePattern": "*.penpot"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify --sourcemap",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "typescript": "^5.9.0"
  }
}
